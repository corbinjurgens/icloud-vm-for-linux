# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#
# DISK_SIZE rule (plan D10): 40 GB + (total iCloud Drive data) rounded up to the
# next 20 GB. The qcow2 image grows on demand, so oversizing costs nothing upfront.
# Example: 70 GB of iCloud data -> 120G.
DISK_SIZE=120G

# RAM for the guest. Do not go below 2.5G (Windows update servicing needs it).
RAM_SIZE=3G

# vCPUs for the guest.
CPU_CORES=2

# Password for the dedicated 'syncshare' SMB account (plan D8).
# MUST be strong: 20+ random characters. This same value goes into the host
# credentials file at /etc/credentials-icloud.
SHARE_PASS=CHANGE_ME_STRONG_PASSWORD
