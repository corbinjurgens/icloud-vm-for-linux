# Copy to /etc/systemd/system/icloud-health.timer
[Unit]
Description=Run iCloud VM health check every 10 minutes
# Durable desired-off marker (v2 plan D29); see icloud-health.service.
ConditionPathExists=!/var/lib/icloud-bridge/powered-off

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min

[Install]
WantedBy=timers.target
