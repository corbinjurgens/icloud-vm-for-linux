# Copy to /etc/systemd/system/mnt-icloud_bridge.mount
# The mount-path component is icloud_bridge (underscore) so the only hyphen in
# the unit name is systemd's encoding of the /mnt/... slash -- no literal-hyphen
# escaping is needed (v2 plan D16).
# uid/gid 1000 = the primary desktop user; adjust to `id -u` / `id -g`.
# See mnt-icloud.mount for why cache=strict/actimeo=1 are load-bearing and why
# there is no sign/seal/mfsymlinks (v2 plan D32/D33). No `rasize` here: this share
# only ever carries small JSON documents, so readahead tuning buys nothing.
# No `noperm` either (v2 plan D50): the exported directory is created by
# 04-bridge-agent.ps1 and carries no DOS read-only attribute, so its root stats
# as dir_mode's 0775 and the host already writes requests and exclusions.json
# there. The client-side check is doing nothing here, and leaving it in place
# keeps this mount's option list a statement about what it actually needs.
[Unit]
Description=iCloud bridge control share (CIFS)
Requires=docker.service
After=docker.service
# Durable desired-off marker (v2 plan D29); see mnt-icloud.mount for rationale.
ConditionPathExists=!/var/lib/icloud-bridge/powered-off

[Mount]
What=//127.0.0.1/bridge
Where=/mnt/icloud_bridge
Type=cifs
Options=credentials=/etc/credentials-icloud,port=10445,vers=3.1.1,uid=1000,gid=1000,file_mode=0664,dir_mode=0775,actimeo=1,echo_interval=15,_netdev
TimeoutSec=30

[Install]
WantedBy=multi-user.target
